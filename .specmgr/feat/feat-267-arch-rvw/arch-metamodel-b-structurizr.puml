@startuml arch-metamodel-b-structurizr
title Architecture Model - Metamodel B (realisation in Structurizr)

' to be confirmed = not yet verified with the probe
' A: = concept of metamodel A (arch-metamodel-a-conceptual.puml)
class "Workspace" as WS
class "Model" as MOD
abstract class "Element" as EL
class "Person" as PER
class "SoftwareSystem" as SYS
class "Container" as CON
class "Component" as CMP
class "Relationship" as REL
class "DeploymentNode" as DN
class "InfrastructureNode" as IN
class "ContainerInstance" as CI
class "View" as VIEW
class "Perspective" as PSP
class "Property" as PROP
class "Tag" as TAG
class "Group" as GRP
class "Docs" as DOC
class "A: View" as AVW <<42010>>

WS "1" *-- "1" MOD
WS "1" *-- "0..*" VIEW
WS "1" o-- "0..*" DOC : docs, adrs (to be confirmed)
MOD "1" *-- "0..*" PER
MOD "1" *-- "0..*" SYS
SYS "1" *-- "0..*" CON
CON "1" *-- "0..*" CMP
MOD "1" *-- "0..*" REL
MOD "1" *-- "0..*" DN
DN "1" *-- "0..*" DN : nested
DN "1" *-- "0..*" IN
DN "1" *-- "0..*" CI
CI "0..*" --> "1" CON : instance of

EL <|-- PER
EL <|-- SYS
EL <|-- CON
EL <|-- CMP
EL <|-- DN
EL <|-- IN
EL <|-- CI
REL "0..*" --> "1" EL : source
REL "0..*" --> "1" EL : destination

VIEW "1" --> "1..*" EL : shows
VIEW "0..*" --> "1..*" AVW : presents part of

PER "0..*" -- "0..1" GRP
SYS "0..*" -- "0..1" GRP
CON "0..*" -- "0..1" GRP

PSP "0..*" --> "1" EL : on element
PSP "0..*" --> "1" REL : on relationship
PROP "0..*" --> "1" MOD : on model
PROP "0..*" --> "1" EL : on element
PROP "0..*" --> "1" REL : explicit only
TAG "0..*" --> "1" EL : on element
TAG "0..*" --> "1" REL

note right of PSP
  one perspective per review criterion
  name = criterion ID (e.g. VP06-RE-100)
  value = rating word
  description = evidence level + finding summary
  name unique per element (duplicate = parse error)
  style on value works in renderer only
end note

note right of PROP
  keys [a-z0-9.], values never empty
  duplicate key: last value wins, silently
  origin, provenance
  trust.boundary (not on group)
  failure.domain.host|zone|region
  properties only in JSON export
end note

note bottom of GRP
  a group holds no properties
  group name is display only
end note

note bottom of AVW
  a C4 view is a presentation,
  not a 42010 view; one C4 view can
  serve several viewpoints
  record of the viewpoint: to be confirmed
end note

@enduml
