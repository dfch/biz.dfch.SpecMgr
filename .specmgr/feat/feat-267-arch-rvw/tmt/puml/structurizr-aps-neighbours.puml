@startuml
title <size:24>Container View: TMT Observatory System</size>\n<size:24>VP02 Functional: APS and its interfaces</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(APSUser, "APS User", $descr="Runs alignment and phasing procedures. Stakeholder block of the APS mission.", $tags="", $link="")
Person(APSOperator, "APS Operator", $descr="Operates the APS. Stakeholder block of the APS mission.", $tags="", $link="")

System_Boundary("TMTObservatorySystem_boundary", "TMT Observatory System", $tags="") {
  AddBoundaryTag("Observatory software", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
  Boundary(group_1, "Observatory software", $tags="Observatory software") {
    Container(TMTObservatorySystem.ExecutiveSoftware, "Executive Software", $techn="Software", $descr="Coordinates observations: acquisition, guiding, pointing acquisition.", $tags="", $link="")
    Container(TMTObservatorySystem.CommonServices, "Common Services", $techn="Software", $descr="Shared observatory services used by subsystems.", $tags="", $link="")
  }

  AddBoundaryTag("Telescope", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
  Boundary(group_2, "Telescope", $tags="Telescope") {
    Container(TMTObservatorySystem.M1ControlSystem, "M1 Control System", $techn="Hardware and software", $descr="Controls the 492 primary mirror segments: piston/tip/tilt, warping harness, edge sensors.", $tags="", $link="")
    Container(TMTObservatorySystem.AlignmentandPhasingSystem, "Alignment and Phasing System", $techn="Hardware and software", $descr="Shack-Hartmann wavefront sensor for the pre-AO wavefront quality: aligns and phases M1, aligns M2 and M3.", $tags="", $link="")
    Container(TMTObservatorySystem.TelescopeControlSystem, "Telescope Control System", $techn="Software", $descr="Tracking, main-axis and M3 offsets, guider offsets, M2 moves.", $tags="", $link="")
  }

}

Rel(APSUser, TMTObservatorySystem.AlignmentandPhasingSystem, "Requests APS procedures", $techn="APS2User port", $tags="", $link="")
Rel(APSOperator, TMTObservatorySystem.AlignmentandPhasingSystem, "Operates", $techn="Console", $tags="", $link="")
Rel(TMTObservatorySystem.AlignmentandPhasingSystem, TMTObservatorySystem.M1ControlSystem, "Commands segment piston/tip/tilt and warping harness", $techn="PEAS2M1CS / APS to M1CS Interface", $tags="", $link="")
Rel(TMTObservatorySystem.M1ControlSystem, TMTObservatorySystem.AlignmentandPhasingSystem, "Acknowledges, reports status and segment configuration", $techn="m1cs2PEAS", $tags="", $link="")
Rel(TMTObservatorySystem.AlignmentandPhasingSystem, TMTObservatorySystem.TelescopeControlSystem, "Requests M2/M3 moves and offsets", $techn="PEAS2TCS", $tags="", $link="")
Rel(TMTObservatorySystem.TelescopeControlSystem, TMTObservatorySystem.AlignmentandPhasingSystem, "Acknowledges and reports status", $techn="TCS2PEAS", $tags="", $link="")
Rel(TMTObservatorySystem.ExecutiveSoftware, TMTObservatorySystem.AlignmentandPhasingSystem, "Starts APS sessions", $techn="ESW2PEAS", $tags="", $link="")
Rel(TMTObservatorySystem.AlignmentandPhasingSystem, TMTObservatorySystem.ExecutiveSoftware, "Reports results", $techn="PEAS2ESW", $tags="", $link="")
Rel(TMTObservatorySystem.AlignmentandPhasingSystem, TMTObservatorySystem.CommonServices, "Uses common services", $techn="PEAS2CS", $tags="", $link="")
Rel(TMTObservatorySystem.ExecutiveSoftware, TMTObservatorySystem.TelescopeControlSystem, "Sends guider offsets and tracking demands", $techn="ESW2TCS", $tags="", $link="")
Rel(TMTObservatorySystem.TelescopeControlSystem, TMTObservatorySystem.ExecutiveSoftware, "Acknowledges", $techn="TCS2ESW", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
