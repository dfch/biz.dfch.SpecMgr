Person(APSUser, "APS User", $descr="Runs alignment and phasing procedures. Stakeholder block of the APS mission.", $tags="", $link="")
Person(APSOperator, "APS Operator", $descr="Operates the APS. Stakeholder block of the APS mission.", $tags="", $link="")

System_Boundary("TMTObservatorySystem_boundary", "TMT Observatory System", $tags="") {
  AddBoundaryTag("Adaptive optics (NFIRAOS)", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
  Boundary(group_1, "Adaptive optics (NFIRAOS)", $tags="Adaptive optics (NFIRAOS)") {
    Container(TMTObservatorySystem.AOSequencer, "AO Sequencer", $techn="Software", $descr="Sequences the adaptive optics system.", $tags="", $link="")
    Container(TMTObservatorySystem.NFIRAOSComponentController, "NFIRAOS Component Controller", $techn="Hardware and software", $descr="Controls the NFIRAOS opto-mechanical components.", $tags="", $link="")
    Container(TMTObservatorySystem.NRTC, "NRTC", $techn="Software", $descr="NFIRAOS real-time controller.", $tags="", $link="")
    Container(TMTObservatorySystem.RPG, "RPG", $techn="Software", $descr="Reconstructor parameter generator.", $tags="", $link="")
    Container(TMTObservatorySystem.DM, "DM", $techn="Hardware", $descr="Deformable mirror.", $tags="", $link="")
    Container(TMTObservatorySystem.NSCU, "NSCU", $techn="Hardware and software", $descr="NFIRAOS science calibration unit.", $tags="", $link="")
    Container(TMTObservatorySystem.TTS, "TTS", $techn="Unknown", $descr="Named TTS in the model (not expanded there).", $tags="", $link="")
    Container(TMTObservatorySystem.NSEN, "NSEN", $techn="Unknown", $descr="Named NSEN in the model (not expanded there).", $tags="", $link="")
    Container(TMTObservatorySystem.ESEN, "ESEN", $techn="Unknown", $descr="Named ESEN in the model (not expanded there).", $tags="", $link="")
  }

  AddBoundaryTag("Instruments", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
  Boundary(group_2, "Instruments", $tags="Instruments") {
    Container(TMTObservatorySystem.IRISSequencer, "IRIS Sequencer", $techn="Software", $descr="Sequences the IRIS instrument.", $tags="", $link="")
    Container(TMTObservatorySystem.IRISImagerDetector, "IRIS Imager Detector", $techn="Hardware and software", $descr="IRIS imager detector.", $tags="", $link="")
    Container(TMTObservatorySystem.IRISOIWFS, "IRIS - OIWFS", $techn="Hardware and software", $descr="IRIS on-instrument wavefront sensor.", $tags="", $link="")
    Container(TMTObservatorySystem.IRISOIWFSPOA, "IRIS - OIWFS POA", $techn="Hardware and software", $descr="Probe arms of the IRIS OIWFS.", $tags="", $link="")
    Container(TMTObservatorySystem.ISM, "ISM", $techn="Hardware and software", $descr="IRIS support element, slewed and offset in the workflows.", $tags="", $link="")
    Container(TMTObservatorySystem.WFOSSequencer, "WFOS Sequencer", $techn="Software", $descr="Sequences the WFOS instrument.", $tags="", $link="")
    Container(TMTObservatorySystem.WFOSOIWFS, "WFOS OIWFS", $techn="Hardware and software", $descr="WFOS on-instrument wavefront sensor.", $tags="", $link="")
  }

  AddBoundaryTag("Laser guide stars", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
  Boundary(group_3, "Laser guide stars", $tags="Laser guide stars") {
    Container(TMTObservatorySystem.LaserGuideStarFacility, "Laser Guide Star Facility", $techn="Hardware and software", $descr="Generates the laser guide star asterism.", $tags="", $link="")
    Container(TMTObservatorySystem.Laser, "Laser", $techn="Hardware", $descr="Laser source.", $tags="", $link="")
    Container(TMTObservatorySystem.BeamTransferOptics, "Beam Transfer Optics", $techn="Opto-mechanical assembly", $descr="Transfers the laser beams to the launch telescope.", $tags="", $link="")
    Container(TMTObservatorySystem.LaserInterlockSystem, "Laser Interlock System", $techn="Hardware and software", $descr="Interlocks laser propagation.", $tags="", $link="")
  }

  AddBoundaryTag("Observatory software", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
  Boundary(group_4, "Observatory software", $tags="Observatory software") {
    Container(TMTObservatorySystem.ExecutiveSoftware, "Executive Software", $techn="Software", $descr="Coordinates observations: acquisition, guiding, pointing acquisition.", $tags="", $link="")
    Container(TMTObservatorySystem.ESWSequencer, "ESW Sequencer", $techn="Software", $descr="Executive sequencer of the observatory workflows.", $tags="", $link="")
    Container(TMTObservatorySystem.ESWAcquisition, "ESW Acquisition", $techn="Software", $descr="Executive acquisition function.", $tags="", $link="")
    Container(TMTObservatorySystem.CommonServices, "Common Services", $techn="Software", $descr="Shared observatory services used by subsystems.", $tags="", $link="")
    ContainerDb(TMTObservatorySystem.DataManagementSystem, "Data Management System", $techn="Software", $descr="Observatory data management.", $tags="", $link="")
  }

  AddBoundaryTag("Safety", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
  Boundary(group_5, "Safety", $tags="Safety") {
    Container(TMTObservatorySystem.ObservatorySafetySystem, "Observatory Safety System", $techn="Hardware and software", $descr="Observatory-wide safety system.", $tags="", $link="")
  }

  AddBoundaryTag("Telescope", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
  Boundary(group_6, "Telescope", $tags="Telescope") {
    Container(TMTObservatorySystem.TCSaORC, "TCS aORC", $techn="Software", $descr="TCS function, named aORC in the model (not expanded there).", $tags="", $link="")
    Container(TMTObservatorySystem.MountControlSystem, "Mount Control System", $techn="Hardware and software", $descr="Controls the telescope mount axes.", $tags="", $link="")
    Container(TMTObservatorySystem.M1ControlSystem, "M1 Control System", $techn="Hardware and software", $descr="Controls the 492 primary mirror segments: piston/tip/tilt, warping harness, edge sensors.", $tags="", $link="")
    Container(TMTObservatorySystem.M2System, "M2 System", $techn="Hardware and software", $descr="Active secondary mirror.", $tags="", $link="")
    Container(TMTObservatorySystem.M3System, "M3 System", $techn="Hardware and software", $descr="Articulated tertiary mirror.", $tags="", $link="")
    Container(TMTObservatorySystem.Enclosure, "Enclosure", $techn="Hardware and software", $descr="Telescope enclosure.", $tags="", $link="")
    Container(TMTObservatorySystem.AlignmentandPhasingSystem, "Alignment and Phasing System", $techn="Hardware and software", $descr="Shack-Hartmann wavefront sensor for the pre-AO wavefront quality: aligns and phases M1, aligns M2 and M3.", $tags="", $link="")
    Container(TMTObservatorySystem.TelescopeControlSystem, "Telescope Control System", $techn="Software", $descr="Tracking, main-axis and M3 offsets, guider offsets, M2 moves.", $tags="", $link="")
  }

}

