}

component "FEAT" {
component "Reverse Feature" as [feat-42-reverse-feat] <<FEAT>>
}

[DEC-c00ec00e-c00e-4c0e-8c0e-c00ec00ec00e] --> [feat-42-reverse-feat]
[feat-42-reverse-feat] -[#red]-> [REQ-c006c006-c006-4c06-8c06-c006c006c006]
